# Copy to .env and fill in real values: cp .env.example .env
# Generate a key: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml: `docker compose up -d db`)
DATABASE_URL=postgres://memory_service:memory_service@localhost:5432/memory_service
